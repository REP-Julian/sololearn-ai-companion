{
  "manifest_version": 3,
  "name": "SoloLearn AI Automation Solver",
  "version": "1.0.0",
  "description": "Flawless AI-powered automation solver for SoloLearn activities using OpenRouter models (Claude 3.5 Sonnet, GPT-4o, DeepSeek, etc.).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://*.sololearn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.sololearn.com/*",
        "https://sololearn.com/*"
      ],
      "js": [
        "src/config.js",
        "src/openrouter.js",
        "src/parser.js",
        "src/executor.js",
        "src/ui.js",
        "src/main.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_end"
    }
  ]
}
