{
  "manifest_version": 3,
  "name": "SoloLearn AI Companion",
  "version": "2.1.5",
  "description": "Multi-Provider AI (Codestral, Gemini, Hugging Face) with Continuous Adaptive Learning & Self-Correction for SoloLearn interactive courses, quizzes, and code rearrange exercises.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.mistral.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://router.huggingface.co/*",
    "https://api-inference.huggingface.co/*",
    "https://huggingface.co/*",
    "https://*.sololearn.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.sololearn.com/*",
        "https://sololearn.com/*"
      ],
      "js": [
        "src/config.js",
        "src/memory.js",
        "src/mistral.js",
        "src/providers/gemini.js",
        "src/providers/huggingface.js",
        "src/consensus.js",
        "src/parser.js",
        "src/executor.js",
        "src/ui.js",
        "src/main.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_end"
    }
  ]
}
